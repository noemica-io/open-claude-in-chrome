{
  "manifest_version": 3,
  "name": "Open Claude in Chrome",
  "version": "1.0.2",
  "description": "Claude in Chrome, open source. No domain blocklist. Any Chromium browser, or Firefox.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "debugger",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabGroups",
    "windows",
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Open Claude in Chrome \u2014 click to start/stop recording"
  },
  "options_page": "recorder/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "recorder/capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "open-claude-in-chrome@hrideshmg.com",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/hrideshmg/open-claude-in-chrome/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications"
        ]
      }
    }
  }
}
